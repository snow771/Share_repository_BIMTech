<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SimilaritySearchApp</RootNamespace>
    <AssemblyName>SimilaritySearchApp</AssemblyName>
    <AssemblyTitle>類似物件・実績検索ツール</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- Stencile変換: Excel の読込（計算済みの値を高速に読む）・書出し・マッピング YAML -->
    <PackageReference Include="ExcelDataReader" Version="3.7.0" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="YamlDotNet" Version="16.1.3" />
    <!-- 見積AI-OCR: PDF のページ数・2ページずつの分割 -->
    <PackageReference Include="PDFsharp" Version="6.1.1" />
  </ItemGroup>

  <!-- 画面ファイル（HTML/CSS/JS）を出力フォルダへコピー -->
  <ItemGroup>
    <None Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- 同梱の既定マッピング（Stencile のセル位置定義） -->
    <None Include="Stencil\Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- 同梱の構造化ルール（見積AI-OCR の共通ルール・協力業者差分ルール） -->
    <None Include="Ocr\Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SimilaritySearchApp.Tests" />
  </ItemGroup>

</Project>
