<!-- 概要タブ：選択要素、製品カード、複合レイヤーとProduct_ID、選択時の警告を確認専用に表示します。 -->
<!-- ID付与の操作（プレビュー→確認ダイアログ→書込み）は「検索」タブで行います。 -->
<UserControl x:Class="Bui.UI.Tabs.OverviewView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="12">
   <!-- 製品カード：選択要素に付与されたProduct_IDの製品仕様を、設計者が読める形で示します。 -->
   <!-- タブは固定ではなく ProductCardTabs の数だけ作られます（Display_Groupsに追随します）。 -->
   <Border BorderBrush="#FF9E9E9E" BorderThickness="1" Padding="10" Margin="0,0,0,14"
           Visibility="{Binding HasProductCard, Converter={StaticResource BoolToVisibility}}">
    <StackPanel>
     <!-- ヘッダー：画像／製品名／メーカー名／建材分類／Product ID -->
     <Grid>
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="Auto"/>
       <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Width="96" Height="96" Margin="0,0,12,0"
              BorderBrush="#FFBDBDBD" BorderThickness="1" VerticalAlignment="Top">
       <Grid>
        <!-- 画像が無い場合も枠は出します。欄そのものが消えると、レイアウトが製品ごとに変わって読みにくくなります。 -->
        <TextBlock Text="画像なし" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF757575"/>
        <Image Source="{Binding ProductCard.ImagePath}" Stretch="Uniform" Margin="2"
               Visibility="{Binding HasProductImage, Converter={StaticResource BoolToVisibility}}"/>
       </Grid>
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Top">
       <TextBlock Text="{Binding ProductCard.ProductName}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding ProductCard.ManufacturerName}" TextWrapping="Wrap" Margin="0,2,0,0"/>
       <TextBlock Text="{Binding ProductCard.CategoryName}" TextWrapping="Wrap" Foreground="#FF616161"/>
       <!-- どの層の製品を見ているかを必ず文字で出します。 -->
       <!-- 出さないと、下地を選んだのか仕上に戻ったのか画面から判別できません。 -->
       <TextBlock Text="{Binding ProductCardLayerLabel, StringFormat=表示中の層: {0}}" TextWrapping="Wrap"
                  Foreground="#FF0B6E4F" FontWeight="SemiBold" Margin="0,4,0,0">
        <TextBlock.Style>
         <Style TargetType="TextBlock">
          <!-- 仕上に戻っているとき（空文字）は行ごと隠します。 -->
          <Setter Property="Visibility" Value="Visible"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding ProductCardLayerLabel}" Value="">
            <Setter Property="Visibility" Value="Collapsed"/>
           </DataTrigger>
          </Style.Triggers>
         </Style>
        </TextBlock.Style>
       </TextBlock>
       <TextBlock Text="{Binding ProductCard.ProductId, StringFormat=Product ID: {0}}"
                  TextWrapping="Wrap" Margin="0,4,0,0"/>
      </StackPanel>
     </Grid>

     <TabControl ItemsSource="{Binding ProductCardTabs}" Margin="0,10,0,0" MinHeight="150">
      <TabControl.ItemTemplate>
       <DataTemplate>
        <TextBlock Text="{Binding Header}"/>
       </DataTemplate>
      </TabControl.ItemTemplate>
      <TabControl.ContentTemplate>
       <DataTemplate>
        <Grid>
         <!-- 行が無いタブでも、なぜ空なのかを必ず文字で示します。 -->
         <TextBlock Text="{Binding EmptyMessage}" TextWrapping="Wrap" Margin="6" Foreground="#FF616161">
          <TextBlock.Style>
           <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
             <DataTrigger Binding="{Binding Rows.Count}" Value="0">
              <Setter Property="Visibility" Value="Visible"/>
             </DataTrigger>
            </Style.Triggers>
           </Style>
          </TextBlock.Style>
         </TextBlock>
         <ItemsControl ItemsSource="{Binding Rows}" Margin="2">
          <ItemsControl.ItemTemplate>
           <DataTemplate>
            <!-- 2段構成：上段が値（＋単位）、下段が根拠（信頼度・情報源）です。 -->
            <!-- 横3列に並べると、パネルが狭いときに根拠の文字が切れて読めなくなります。 -->
            <Grid Margin="4,4">
             <Grid.ColumnDefinitions>
              <ColumnDefinition Width="120"/>
              <ColumnDefinition Width="*"/>
             </Grid.ColumnDefinitions>
             <TextBlock Grid.Column="0" Text="{Binding Label}" TextWrapping="Wrap"
                        Foreground="#FF616161" VerticalAlignment="Top"/>
             <StackPanel Grid.Column="1">
              <TextBlock Text="{Binding Value}" TextWrapping="Wrap"/>
              <!-- 根拠が無い行では、この段ごと消して余白を作りません。 -->
              <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="11"
                         Foreground="#FF757575" Margin="0,1,0,0">
               <TextBlock.Style>
                <Style TargetType="TextBlock">
                 <Setter Property="Visibility" Value="Visible"/>
                 <Style.Triggers>
                  <DataTrigger Binding="{Binding Note}" Value="">
                   <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                 </Style.Triggers>
                </Style>
               </TextBlock.Style>
              </TextBlock>
             </StackPanel>
            </Grid>
           </DataTemplate>
          </ItemsControl.ItemTemplate>
         </ItemsControl>
        </Grid>
       </DataTemplate>
      </TabControl.ContentTemplate>
     </TabControl>
    </StackPanel>
   </Border>

   <!-- カードを出せない場合は、その理由だけを同じ位置に出します。 -->
   <TextBlock Text="{Binding ProductCardMessage}" TextWrapping="Wrap" Margin="0,0,0,14" Foreground="#FF616161">
    <TextBlock.Style>
     <Style TargetType="TextBlock">
      <Setter Property="Visibility" Value="Visible"/>
      <Style.Triggers>
       <DataTrigger Binding="{Binding HasProductCard}" Value="True">
        <Setter Property="Visibility" Value="Collapsed"/>
       </DataTrigger>
      </Style.Triggers>
     </Style>
    </TextBlock.Style>
   </TextBlock>

   <TextBlock Text="現在の選択" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
   <TextBlock Text="{Binding Selection.CategoryName, StringFormat=カテゴリ: {0}}" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding Selection.ElementDisplayName, StringFormat=要素: {0}}" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding Selection.TypeName, StringFormat=タイプ: {0}}" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding Selection.SameTypeCount, StringFormat=同タイプ数: {0}}"/>
   <!-- Product_ID・CSV接続・CSV更新・CSV詳細・状態はここには出しません。 -->
   <!-- Product_IDは下の複合レイヤーの表に層ごとに出ています。 -->
   <!-- CSV接続・CSV更新・CSV詳細は【設定】タブ、状態は【検索】タブに同じものが出ています。 -->
   <!-- 概要タブは確認専用で操作をしないため、操作の結果を出す必要がありません。 -->
   <TextBlock Text="{Binding AssemblyId, StringFormat=Assembly_ID: {0}}" TextWrapping="Wrap" Margin="0,0,0,10"/>

   <!-- 選択読込み時の警告（複数選択・リンク要素・読取専用・複合構造の読取失敗など）です。 -->
   <!-- StatusMessageは検索タブでしか出さなくなったため、複合レイヤーが空/違う要素の詳細に -->
   <!-- なる理由がここでしか分からなくなります。必ず一覧の直前に置きます。 -->
   <TextBlock Text="{Binding SelectionWarningText}" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#FFB35C00"
              Visibility="{Binding HasSelectionWarning, Converter={StaticResource BoolToVisibility}}"/>

   <TextBlock Text="複合レイヤー" FontWeight="SemiBold"/>
   <TextBlock TextWrapping="Wrap" Margin="0,2,0,4"
              Text="この要素の複合レイヤーです。行をクリックすると、上の製品カードがその層の製品に切り替わります。選択を外すと仕上に戻ります。IDの付与は「検索」タブで行います。"/>
   <ListBox ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer}" MaxHeight="240"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="2,4">
     <TextBlock Text="{Binding LayerLabel}" FontWeight="SemiBold"/>
     <TextBlock Text="{Binding Function, StringFormat=機能: {0}}"/>
     <TextBlock Text="{Binding ThicknessMillimeters, StringFormat=厚さ: {0} mm}"/>
     <TextBlock Text="{Binding RevitMaterialName, StringFormat=材料: {0}}" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding ProductId, StringFormat=Product_ID: {0}}" TextWrapping="Wrap"/>
     <!-- 状態は色だけでなく必ず文字でも示します。 -->
     <TextBlock Text="※ Product_ID未設定" TextWrapping="Wrap"
                Visibility="{Binding HasMissingProductId, Converter={StaticResource BoolToVisibility}}"/>
     <TextBlock Text="※ 材料はカテゴリ既定からの代替解決です" TextWrapping="Wrap"
                Visibility="{Binding IsMaterialFallback, Converter={StaticResource BoolToVisibility}}"/>
    </StackPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </StackPanel>
 </ScrollViewer>
</UserControl>
